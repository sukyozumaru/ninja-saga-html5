                                                                                                                                                                                                                                                                                                                                                                                                                                                         public static function addSpecialEffect(param1:MovieClip) : void
                                                                                                                                                                                                                                                                                                                                                                                                                                                         {
                                                                                                                                                                                                                                                                                                                                                                                                                                                            trait method QName(PackageNamespace(""),"addSpecialEffect")
                                                                                                                                                                                                                                                                                                                                                                                                                                                               flag FINAL
                                                                                                                                                                                                                                                                                                                                                                                                                                                               dispid 148
                                                                                                                                                                                                                                                                                                                                                                                                                                                               method
                                                                                                                                                                                                                                                                                                                                                                                                                                                                  name null
                                                                                                                                                                                                                                                                                                                                                                                                                                                                  param QName(PackageNamespace("flash.display"),"MovieClip")
                                                                                                                                                                                                                                                                                                                                                                                                                                                                  returns QName(PackageNamespace(""),"void")
                                                                                                                                                                                                                                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                                                                                                                                                                                                                                  body
                                                                                                                                                                                                                                                                                                                                                                                                                                                                     maxstack 3
                                                                                                                                                                                                                                                                                                                                                                                                                                                                     localcount 2
                                                                                                                                                                                                                                                                                                                                                                                                                                                                     initscopedepth 3
                                                                                                                                                                                                                                                                                                                                                                                                                                                                     maxscopedepth 4
                                                                                                                                                                                                                                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                                                                                                                                                                                                                                     code
                                                                                                                                                                                                                                                                                                                                                                                                                                                                        getlocal0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                        pushscope
                                                                                                                                                                                                                                                                                                                                                                                                                                                                        getlex QName(PackageNamespace("ninjasaga"),"Main")
                                                                                                                                                                                                                                                                                                                                                                                                                                                                        newfunction 4805
                                                                                                                                                                                                                                                                                                                                                                                                                                                                        pop
                                                                                                                                                                                                                                                                                                                                                                                                                                                                        jump ofs000f
                                                                                                                                                                                                                                                                                                                                                                                                                                                                        divide
                                                                                                                                                                                                                                                                                                                                                                                                                                                                        getglobalscope
                                                                                                                                                                                                                                                                                                                                                                                                                                                                        bitnot
                                                                                                                                                                                                                                                                                                                                                                                                                                                               ofs000f:
                                                                                                                                                                                                                                                                                                                                                                                                                                                                        getlocal1
                                                                                                                                                                                                                                                                                                                                                                                                                                                                        callpropvoid QName(PackageNamespace(""),"playBattleEffect"), 1
                                                                                                                                                                                                                                                                                                                                                                                                                                                                        returnvoid
                                                                                                                                                                                                                                                                                                                                                                                                                                                                     end ; code
                                                                                                                                                                                                                                                                                                                                                                                                                                                                  end ; body
                                                                                                                                                                                                                                                                                                                                                                                                                                                               end ; method
                                                                                                                                                                                                                                                                                                                                                                                                                                                            }
                                                                                                                                                                                                                                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                                                                                                                                                                                                                            private static function removeSpecialEffect() : void
                                                                                                                                                                                                                                                                                                                                                                                                                                                            {
                                                                                                                                                                                                                                                                                                                                                                                                                                                               trait method QName(PrivateNamespace("*"),"removeSpecialEffect")
                                                                                                                                                                                                                                                                                                                                                                                                                                                                  flag FINAL
                                                                                                                                                                                                                                                                                                                                                                                                                                                                  dispid 149
                                                                                                                                                                                                                                                                                                                                                                                                                                                                  method
                                                                                                                                                                                                                                                                                                                                                                                                                                                                     name null
                                                                                                                                                                                                                                                                                                                                                                                                                                                                     returns QName(PackageNamespace(""),"void")
                                                                                                                                                                                                                                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                                                                                                                                                                                                                                     body
                                                                                                                                                                                                                                                                                                                                                                                                                                                                        maxstack 2
                                                                                                                                                                                                                                                                                                                                                                                                                                                                        localcount 1
                                                                                                                                                                                                                                                                                                                                                                                                                                                                        initscopedepth 3
                                                                                                                                                                                                                                                                                                                                                                                                                                                                        maxscopedepth 4
                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                                                                                                                                                                                                                                        code
                                                                                                                                                                                                                                                                                                                                                                                                                                                                           getlocal0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                           pushscope
                                                                                                                                                                                                                                                                                                                                                                                                                                                                           getlex QName(PackageNamespace("ninjasaga"),"Main")
                                                                                                                                                                                                                                                                                                                                                                                                                                                                           newfunction 4806
                                                                                                                                                                                                                                                                                                                                                                                                                                                                           pop
                                                                                                                                                                                                                                                                                                                                                                                                                                                                           callpropvoid QName(PackageNamespace(""),"removeBattleEffect"), 0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                           returnvoid
                                                                                                                                                                                                                                                                                                                                                                                                                                                                        end ; code
                                                                                                                                                                                                                                                                                                                                                                                                                                                                     end ; body
                                                                                                                                                                                                                                                                                                                                                                                                                                                                  end ; method
                                                                                                                                                                                                                                                                                                                                                                                                                                                               }
                                                                                                                                                                                                                                                                                                                                                                                                                                                               
                                                                                                                                                                                                                                                                                                                                                                                                                                                               public static function checkWeaponPurifyRestore(param1:*) : void
                                                                                                                                                                                                                                                                                                                                                                                                                                                               {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                  trait method QName(PackageNamespace(""),"checkWeaponPurifyRestore")
                                                                                                                                                                                                                                                                                                                                                                                                                                                                     flag FINAL
                                                                                                                                                                                                                                                                                                                                                                                                                                                                     dispid 150
                                                                                                                                                                                                                                                                                                                                                                                                                                                                     method
